config/gestures.json.bak-*

# Training center: per-recording summary cache and exported model packages
recordings/*.summary.json
recordings/*.quality.json
recordings/*.cleaned.jsonl.gz
recordings/*.aug*.jsonl.gz
recordings/cleaned/
recordings/crops/
recordings/augmented/
