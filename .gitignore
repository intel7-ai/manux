recordings/.selection.json
recordings/.aug_config.json
recordings_raw_backup/
exports/
models/gestures/
models/backups/
recordings/*.part
.local/
.env
config/tcn-ui.ini
config/recording-plans.json
config/recording-plans.tmp
config/hub.json
config/hub.json.tmp
config/hub_secrets.bin
config/hub_secrets.bin.tmp

# Online learning data: joints of a person using the app (docs/online-learning-design.md)
data/online/

# uv's local package cache (setup-tcn.cmd)
.local/

# What the user asked the AI helper (their own sentences; src/llm_binding.History)
config/ai_connections.json

# The app's own settings (QSettings ini): hand choice, box, AI provider and the encrypted API key
config/tcn-ui.ini
