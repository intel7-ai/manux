{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_discord_discord__(reply|edit_message)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/discord-output-guard.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
