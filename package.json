{
  "name": "manux-motion-player",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local webcam gesture video player for MANUX",
  "author": "intel7-ai",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.mjs",
    "desktop:setup": "node node_modules/electron/install.js",
    "desktop:pack": "node scripts/desktop-build.mjs dir",
    "desktop:dist": "node scripts/desktop-build.mjs dist",
    "test:packaged": "node scripts/test-packaged-app.mjs",
    "test:update-download": "node scripts/test-update-download.mjs",
    "test:installed-update": "node scripts/test-installed-update.mjs",
    "test:mouse": "node scripts/test-mouse-browser.mjs",
    "test:browser": "node scripts/test-mouse-browser.mjs",
    "test:native": "node scripts/test-desktop-mouse.mjs",
    "browser:install": "playwright install chromium",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "harness:check": "node scripts/task-report.mjs harness/task.example.json harness/result.example.json --check",
    "task:report": "node scripts/task-report.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "webm-muxer": "^5.1.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
