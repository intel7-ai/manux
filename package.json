{
  "name": "manux-tooling",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "MANUX shared task reports and verification; application lives in apps/manux",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.js",
    "harness:check": "node scripts/task-report.mjs harness/task.example.json harness/result.example.json --check",
    "task:report": "node scripts/task-report.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
