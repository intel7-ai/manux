{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MANUX task result v1",
  "description": "Recorded evidence, not proof that commands ran. Runtime validation additionally binds request, baseline, criteria and changed files to the task. Complete means task verified; integration and publication are independent recorded facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "baselineCommit",
    "status",
    "summary",
    "changedFiles",
    "checks",
    "acceptance",
    "delivery",
    "limitations",
    "nextSteps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "baselineCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "status": {
      "enum": [
        "blocked",
        "needs_review",
        "complete"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
    },
    "changedFiles": {
      "type": "array",
      "minItems": 0,
      "maxItems": 60,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\<>:\"|?*])[^\\u0000-\\u001f\\u007f]+$"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
          },
          "status": {
            "enum": [
              "met",
              "not_met",
              "not_checked"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrated",
        "published",
        "evidence"
      ],
      "properties": {
        "integrated": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600,
          "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
      },
      "uniqueItems": true
    },
    "nextSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^(?:$|(?=.*\\S)[^\\u0000-\\u001f\\u007f]+)$"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          },
          "acceptance": {
            "items": {
              "properties": {
                "status": {
                  "const": "met"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "published": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "evidence": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "integrated": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "evidence": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
