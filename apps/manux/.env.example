# Copy this file to `apps/manux/.env` (or repository root `.env`) and paste the team token.
# `.env` is ignored by git and automatically loaded by `tools/hub.py`.

# Hugging Face dataset repository for team gesture recordings (.jsonl.gz) and TCN models (.onnx + .json)
MANUX_HF_REPO=se4nchoi/manux-datasets
MANUX_HUB_PROVIDER=huggingface

# Hugging Face fine-grained access token (Read + Write contents on `se4nchoi/manux-datasets`)
HF_TOKEN=hf_paste_your_team_token_here

# Optional GitHub dataset provider. Keep credentials in this ignored file, not the app UI.
# MANUX_HUB_PROVIDER=github
# MANUX_GH_REPO=owner/dataset-repository
# MANUX_GH_BRANCH=main
# MANUX_GH_TOKEN=your_contents_read_write_token
